# ============================================
# CPL - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# === SERVER CONFIGURATION ===
PORT=3000
NODE_ENV=development

# === MONGODB DATABASE ===
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/cpl-game
MONGODB_URI=your_mongodb_connection_string_here

# === JWT SECRET ===
# Generate a random string for JWT token encryption
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# === GOOGLE OAUTH ===
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=790106772220-ai1r66t94b0dhjhgpb0rij5uvemt5jrh.apps.googleusercontent.com

# === FRONTEND URL ===
# Development: http://localhost:3000
# Production: https://your-app.onrender.com
FRONTEND_URL=http://localhost:3000

# === GAME SETTINGS (Optional) ===
MATCH_OVERS=5
LOBBY_TIMEOUT=60
MAX_PLAYERS_PER_ROOM=12

# === CACHE SETTINGS ===
LEADERBOARD_CACHE_MINUTES=5
